  "risk": {
    "exposure_none": 0.02,
    "exposure_low": 0.05,
    "exposure_partial": 0.25,
    "lead_cap_hours": 72,
    "lead_cap_level": "MODERATE",
    "immediate_levels": ["CRITICAL", "HIGH"],
    "event_end_after_missed_cycles": 2
  },
  "notify": {
    "followup_cooldown_hours": 6,
    "max_items_per_email": 30,
    "max_send_attempts": 6,
    "subject_prefix": "[AP Weather]",
    "material_change": {
      "counties_added_min": 2,
      "counties_added_pct": 25,
      "timing_shift_hours": 12,
      "tolerance": {"freeze": 3, "extreme_cold": 4, "heat": 3, "heavy_rain": 0.5, "harvest_rain": 0.5,
