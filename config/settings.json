{
  "platform_name": "AP Weather Intelligence",
  "org_name": "American Prime",
  "tagline": "Agricultural Weather Intelligence & Early Warning",
  "dashboard_url": "https://marketingap-lmc.github.io/ap-weather-intelligence/",
  "display_timezone": "America/Chicago",
  "schedule": {
    "forecast_cycle_hours": 3,
    "forecast_cycle_early_minutes": 15,
    "daily_report_hour_ct": 6,
    "daily_report_minute_ct": 30,
    "weekly_report_weekday": 0,
    "weekly_report_hour_ct": 7,
    "weekly_report_minute_ct": 0,
    "content_email_with_daily": true,
    "drought_refresh_hours": 12,
    "observed_refresh_hours": 12,
    "nass_refresh_hours": 6,
    "storm_reports_refresh_minutes": 30,
    "heartbeat_commit_minutes": 60,
    "maintenance_hour_ct": 3
  },
  "fetch": {
    "nws_concurrency": 3,
    "obs_stations_per_state": 6,
    "forecast_text_max_counties": 12
